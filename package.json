{
  "name": "agent-ready-a11y",
  "version": "1.0.0",
  "description": "Test what AI browser agents (and screen readers) see on your site, using Playwright's accessibility snapshots and axe-core.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:broken": "cross-env SITE=broken playwright test",
    "test:fixed": "cross-env SITE=fixed playwright test",
    "snapshot": "node scripts/print-tree.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "cross-env": "^7.0.3"
  }
}
